<!DOCTYPE html>
<html lang="en">

{% set title = "Technoholic" %}{% include "head-3.njk" %}


<body data-barba="wrapper" data-cursor="true" data-header-sticky="true" data-menu-style="classic"
    data-page-layout="light" data-header-layout="dark" data-menu-layout="light" data-footer-layout="light"
    data-page-loader="false">

{% include "page-chrome-2.njk" %}

{% include "header-3.njk" %}

    <!-- Page -->
    <div id="page" class="project-page" data-barba="container" data-barba-namespace="pph3">


        <!-- Project Page Header -->
        <div data-animate="true" class="project-page-header style_3">

            <!-- Project Page Head -->
            <div class="project-head">

                <!-- Project Title & Category -->
                <div class="project-title">

                    <!-- Project Title -->
                    <h1 class="big-title">Technoholic</h1>
                    <!-- /Project Title -->

                    <!-- Project Category -->
                    <div class="project-cat">Social Media Management</div>
                    <!-- /Project Category -->

                </div>
                <!-- /Project Title & Category -->
            </div>
            <!-- /Project Page Head -->

            <!-- Project Details -->
            <div class="project-details">

                <!-- Project Metas -->
                <div class="project-metas">

                    <!-- Project Meta -->
                    <div class="project-meta project-other">

                        <h5>Since 2018</h5>

                    </div>
                    <!-- /Project Meta -->

                    <!-- Project Meta -->
                    <div class="project-meta meta-summary">

                        <!-- Meta Content-->
                        <h5>An engaging Instagram page and blog dedicated to exploring the technology that surrounds us
                            in our daily lives. This ongoing project has been a journey into the world of social media
                            management and content creation.</h5>
                        <!-- /Meta Content-->

                    </div>
                    <!-- /Project Meta -->

                </div>
                <!-- /Project Metas -->

            </div>
            <!-- /Project Details -->

        </div>
        <!-- /Project Page Header -->


        <!-- Page Content -->
        <div id="content" class="page-content">

            <!--Section-->
            <div class="section">

                <!--Wrapper-->
                <div class="wrapper">

                    <!--Column-->
                    <div class="c-col-12">

                        <!--Single Image-->
                        <div class="single-image">

                            <img data-animation="blockUp" data-duration="1.5" data-color="#e0e0e0" class="has-anim"
                                alt="Single Image" src="../img/projects/technoholic/technoholic.png">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->


                </div>
                <!--/Wrapper-->


                <!--Wrapper-->
                <div class="wrapper-small">

                    <!--Column-->
                    <div class="c-col-4">

                        <!--Text Wrapper-->
                        <div class="text-wrapper">

                            <h2 class="has-anim" data-stagger="0.02" data-duration="1" data-delay=".1"
                                data-animation="charsUp">
                                The First Step.
                            </h2>

                        </div>
                        <!--/Text Wrapper-->

                    </div>
                    <!--/Column-->

                    <!--Column-->
                    <div class="c-col-8">

                        <!--Text Wrapper-->
                        <div class="text-wrapper">

                            <h5 style="color: rgba(25,27,29,.6)" class="has-anim" data-stagger="0.01" data-duration="1"
                                data-delay=".1" data-animation="wordsUp">
                                Through running Technoholic, I've gained valuable insights into growing and maintaining
                                an online presence, understanding audience engagement, and crafting content that
                                resonates with tech enthusiasts.
                            </h5>

                        </div>
                        <!--/Text Wrapper-->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->

                <!--Wrapper-->
                <div class="wrapper">

                    <!--Column-->
                    <div class="c-col-6">

                        <!--Single Image-->
                        <div class="single-image">

                            <img data-animation="blockUp" data-duration="1.5" data-color="#e0e0e0" class="has-anim"
                                alt="Single Image" src="../img/projects/technoholic/instagram.png">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->

                    <!--Column-->
                    <div class="c-col-6">

                        <!--Single Image-->
                        <div class="single-image">

                            <img data-animation="blockUp" data-duration="1.5" data-color="#e0e0e0" class="has-anim"
                                alt="Single Image" src="../img/projects/technoholic/blog.png">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->



                </div>
                <!--/Wrapper-->

            </div>
            <!--/Section -->



        </div>
        <!-- /Page Content -->

        <!-- Next Project Section-->
        <div class="next-project-section section no-margin">

            <!--Next Project URL --><a href="sneakerPage.html">

                <!-- Next Project Image-->
                <div class="next-project-image">

                    <img alt="Next Project Image" src="../img/projects/sneaker/sneaker.png">

                </div>
                <!--/ Next Project Image-->

                <!-- Next Project Meta Wrapper-->
                <div class="wrapper-small no-nargin">

                    <div class="c-col-12">

                        <div class="next-project-wrap">

                            <!-- Next Project Text-->
                            <span>Next Project</span>
                            <!--/ Next Project Text-->

                            <!-- Next Project Title-->
                            <h1 class="next-project-title">Sneaker Product Page</h1>
                            <!--/ Next Project Title-->

                        </div>

                    </div>

                </div>
                <!--/ Next Project Meta Wrapper-->

            </a>

        </div>
        <!--/ Next Project Section-->

    </div>
    <!-- /Page -->

{% include "footer-1.njk" %}

{% include "scripts-1.njk" %}
</body>

</html>