                                <!-- Carousel Image -->
                                <div class="ai-image">
                                    <img alt="Carousel Image" src="../img/projects/studio23/Context.png">
                                </div>
                                <!-- /Carousel Image -->

                                <!-- Carousel Image -->
                                <div class="ai-image">
                                    <img alt="Carousel Image" src="../img/projects/studio23/crimson.jpeg">
                                </div>
                                <!-- /Carousel Image -->

                            </div>
                            <!-- /Carousel Wrapper -->

                        </div>
                        <!-- /Image Carousel -->

                    </div>
