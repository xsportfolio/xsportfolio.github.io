            <!--Section-->
            <div class="section">



                <!--Wrapper-->
                <div class="wrapper-full">

                    <!--Column-->
                    <div class="c-col-6">
                        <!--Single Image-->
                        <div class="single-image">

                            <img data-animation="slideLeft" data-duration="1" data-color="#e3cdb6" class="has-anim"
