                    </div>
                    <!-- /Project Meta -->

                    <!-- Project Meta -->
                    <div class="project-meta meta-summary">

                        <!-- Meta Content-->
                        <h5>This passion project involves collaboration with Australian artists to create bold,
                            impactful seasonal artworks. Each piece is designed to represent a specific theme,
                            showcasing the diverse talents of our creative community while exploring contemporary
                            concepts through visual expression.</h5>
                        <!-- /Meta Content-->

                    </div>
                    <!-- /Project Meta -->

                    <!-- Project Meta -->
