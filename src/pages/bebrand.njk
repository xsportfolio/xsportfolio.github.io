<!DOCTYPE html>
<html lang="en">

{% set title = "Be Brand" %}{% include "head-3.njk" %}


<body data-barba="wrapper" data-cursor="true" data-header-sticky="true" data-menu-style="classic"
    data-page-layout="light" data-header-layout="dark" data-menu-layout="light" data-footer-layout="light"
    data-page-loader="false">

{% include "page-chrome-1.njk" %}

{% include "header-3.njk" %}

    <!-- Page -->
    <div id="page" class="project-page" data-barba="container" data-barba-namespace="pph1">

        <!-- Project Page Header -->
        <div data-animate="true" class="project-page-header style_1">

            <!-- Project Header Image -->
            <div class="project-fetaured-image">

                <img alt="Project Featured Image" src="../img/projects/bebrand/coverWhite.png">

            </div>
            <!-- /Project Header Image -->

            <!-- Project Details -->
            <div class="project-details">

                <!-- Project Title & Cat -->
                <div class="project-title">

                    <!-- Project Title -->
                    <h1 class="big-title">BE</h1>
                    <!-- Project Title -->

                </div>
                <!-- /Project Title & Cat -->

                <!-- Project Metas -->
                <div class="project-metas">

                    <!-- Project Meta -->
                    <div class="project-meta project-cats">

                        <!-- Project Cats-->
                        <div class="project-cat">Clothing Brand</div>
                        <!-- /Project Cats-->

                    </div>
                    <!-- /Project Meta -->

                    <!-- Project Meta -->
                    <div class="project-meta meta-summary">

                        <!-- Meta Content-->
                        <h5>Founded on the belief that true luxury lies in being unapologetically oneself, BE creates
                            timeless garments that honor the purest state of human expression. Each piece acts as an
                            extension of the wearer, rejecting trends in favor of enduring design that allows
                            individuals to simply Be. Through mindful creation and minimalist philosophy, BE crafts
                            premium essentials that align with the natural rhythms of those who wear them.</h5>
                        <!-- /Meta Content-->

                    </div>
                    <!-- /Project Meta -->

                    <!-- Project Meta -->
                    <div class="project-meta project-other">

                        <h5>2024</h5>

                    </div>
                    <!-- /Project Meta -->

                </div>
                <!-- /Project Metas -->

            </div>
            <!-- Project Details -->

        </div>
        <!-- /Project Page Header -->

        <!-- Page Content -->
        <div id="content" class="page-content">

            <!--Section-->
            <div class="section">

                <!--Wrapper-->
                <div class="wrapper">

                    <!--Column-->
                    <div class="c-col-6">

                        <!--Single Image-->
                        <div data-lightbox="img/projects/project-6/image_2.jpg" class="single-image">

                            <img alt="Single Image" src="../img/projects/bebrand/logo.png">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->

                    <!--Column-->
                    <div class="c-col-6">

                        <!--Single Image-->
                        <div data-lightbox="img/projects/project-6/image_3.jpg" class="single-image">

                            <img alt="Single Image" src="../img/projects/bebrand/1.png">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->

                <!--Wrapper-->
                <div class="wrapper-small">

                    <!--Column-->
                    <div class="c-col-12">

                        <!--Text Wrapper-->
                        <div class="text-wrapper">

                            <h3 class="has-anim" data-stagger="0.1" data-duration="1.5" data-delay=".1"
                                data-animation="linesUp">
                                In collaboration with a passionate fashion hobbyist turned entrepreneur, we
                                embarked on creating BE's visual identity. Through thoughtful conversations about his
                                frustrations with trend-driven fashion and disposable clothing culture, we developed a
                                brand essence that champions authenticity and timeless design.
                            </h3>

                        </div>
                        <!--/Text Wrapper-->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->

                <!--Wrapper-->
                <div class="wrapper-full no-gap">

                    <!--Column-->
                    <div class="c-col-12 no-gap">

                        <!-- Image Carousel -->
                        <div data-navigate="scroll" class="a-image-carousel">

                            <!-- Carousel Wrapper -->
                            <div class="ai-wrapper">

                                <!-- Carousel Image -->
                                <div class="ai-image">
                                    <img alt="Carousel Image" src="../img/projects/bebrand/model1.jpeg">
                                </div>
                                <!-- /Carousel Image -->

                                <!-- Carousel Image -->
                                <div class="ai-image">
                                    <img alt="Carousel Image" src="../img/projects/bebrand/model2.jpeg">
                                </div>
                                <!-- /Carousel Image -->

                                <!-- Carousel Image -->
                                <div class="ai-image">
                                    <img alt="Carousel Image" src="../img/projects/bebrand/conscious.png">
                                </div>
                                <!-- /Carousel Image -->

                                <!-- Carousel Image -->
                                <div class="ai-image">
                                    <img alt="Carousel Image" src="../img/projects/bebrand/cosmos.png">
                                </div>
                                <!-- /Carousel Image -->

                                <!-- Carousel Image -->
                                <div class="ai-image">
                                    <img alt="Carousel Image" src="../img/projects/bebrand/clarity.png">
                                </div>
                                <!-- /Carousel Image -->



                            </div>
                            <!-- /Carousel Wrapper -->

                        </div>
                        <!-- /Image Carousel -->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->

                <!--Wrapper-->
                <div class="wrapper-small">

                    <!--Column-->
                    <div class="c-col-4">

                        <!--Text Wrapper-->
                        <div class="text-wrapper">

                            <h2 class="has-anim" data-stagger="0.02" data-duration="1" data-delay=".1"
                                data-animation="charsUp">
                                Simplicity.
                            </h2>

                        </div>
                        <!--/Text Wrapper-->

                    </div>
                    <!--/Column-->

                    <!--Column-->
                    <div class="c-col-8">

                        <!--Text Wrapper-->
                        <div class="text-wrapper">

                            <h5 style="color: rgba(25,27,29,.6)" class="has-anim" data-stagger="0.02" data-duration="1"
                                data-delay=".1" data-animation="wordsUp">
                                Together, we curated a minimalist visual language—from the restrained color palette to
                                the considered typography—that mirrors his vision of clothing as a pure form of
                                self-expression. Each element was carefully chosen to reflect BE's commitment to
                                creating garments that transcend seasonal cycles and honor the wearer's inherent worth,
                                marking Sam's bold transition from fashion enthusiast to founder of a brand that stands
                                for something more meaningful in the industry.
                            </h5>

                        </div>
                        <!--/Text Wrapper-->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->

            </div>
            <!--/Section -->

            <!--Section-->
            <div class="section">

                <!--Wrapper-->
                <div class="wrapper">

                    <!--Column-->
                    <div class="c-col-12">

                        <!--Single Image-->
                        <div class="single-image">

                            <img alt="Single Image" data-animation="slideLeft" data-duration="1.5" data-delay="0"
                                data-color="#caaf9c" class="has-anim" src="../img/projects/bebrand/cover.png">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->



                </div>
                <!--/Wrapper-->

                <!--Wrapper-->
                <div class="wrapper-small">

                    <!--Column-->
                    <div class="c-col-4"></div>
                    <!--/Column-->

                    <!--Column-->
                    <div class="c-col-8">

                        <!--Text Wrapper-->
                        <div class="text-wrapper">

                            <h5 class="has-anim" data-stagger="0.01" data-duration="1" data-delay=".1"
                                data-animation="wordsUp">
                                "Thank you for trusting me with bringing BE's vision to life. Your
                                commitment to authenticity and courage to challenge fashion's status quo made this
                                collaboration truly meaningful. It's been inspiring to work with someone who believes so
                                deeply in creating something of lasting value." - Jason
                            </h5>

                        </div>
                        <!--/Text Wrapper-->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->

            </div>
            <!--/Section -->



        </div>
        <!-- /Page Content -->

        <!-- Next Project Section-->
        <div class="next-project-section section no-margin">

            <!--Next Project URL --><a href="ATS.html">

                <!-- Next Project Image-->
                <div class="next-project-image">

                    <img alt="Next Project Image" src="../img/projects/ATS/featured.png">

                </div>
                <!--/ Next Project Image-->

                <!-- Next Project Meta Wrapper-->
                <div class="wrapper-small no-nargin">

                    <div class="c-col-12">

                        <div class="next-project-wrap">

                            <!-- Next Project Text-->
                            <span>Next Project</span>
                            <!--/ Next Project Text-->

                            <!-- Next Project Title-->
                            <h1 class="next-project-title">All Things Social</h1>
                            <!--/ Next Project Title-->

                        </div>

                    </div>

                </div>
                <!--/ Next Project Meta Wrapper-->

            </a>

        </div>
        <!--/ Next Project Section-->
    </div>
    <!-- /Page -->

