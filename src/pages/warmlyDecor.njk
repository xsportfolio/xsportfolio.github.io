<!DOCTYPE html>
<html lang="en">

{% set title = "Warmly Decor" %}{% include "head-3.njk" %}


<body data-barba="wrapper" data-cursor="true" data-header-sticky="true" data-menu-style="classic"
    data-page-layout="light" data-header-layout="dark" data-menu-layout="light" data-footer-layout="light"
    data-page-loader="false">

{% include "page-chrome-1.njk" %}

{% include "header-3.njk" %}

    <!-- Page -->
    <div id="page" class="project-page" data-barba="container" data-barba-namespace="pph2">

        <!-- Project Page Header -->
        <div data-animate="true" class="project-page-header style_2">

            <!-- Project Header Image -->
            <div class="project-featured-image">
                <img alt="Project Featured Image" src="../img/projects/warmly/background.png">
            </div>
            <!-- /Project Header Image -->

            <!-- Project Head -->
            <div class="project-head">

                <!-- Project Title -->
                <div class="project-title">
                    <h1 class="big-title">Warmly Decor</h1>
                </div>
                <!-- /Project Title -->

                <!-- Project Category -->
                <div class="project-cat">Brand</div>
                <!-- /Project Category -->

            </div>
            <!-- /Project Head -->

            <!-- Project Details -->
            <div class="project-details">

                <!-- Project Metas -->
                <div class="project-metas">

                    <!-- Project Meta -->
                    <div class="project-meta project-other">

                        <h5>Jason & Matt</h5>

                    </div>
                    <!-- /Project Meta -->

                    <!-- Project Meta -->
                    <div class="project-meta meta-summary">

                        <!-- Meta Content-->
                        <h5>"Warmly Decor is the go-to destination for stylish lighting and furniture at affordable
                            prices. We believe that creating a cozy, inviting home shouldn't break the bank. Our
                            carefully curated collection features a wide range of lighting solutions and furniture
                            pieces that blend form and function, allowing you to illuminate and furnish your space with
                            warmth and personality."</h5>
                        <!-- /Meta Content-->

                    </div>
                    <!-- /Project Meta -->

                </div>
                <!-- /Project Metas -->

            </div>
            <!-- /Project Details -->

        </div>
        <!-- /Project Page Header -->

        <!-- Page Content -->
        <div id="content" class="page-content">

            <!--Section-->
            <div class="section">

                <!--Wrapper-->
                <div class="wrapper">

                    <!--Column-->
                    <div class="c-col-6">

                        <!--Single Image-->
                        <div data-lightbox="img/projects/ATS/fbMockup.png" class="single-image">

                            <img data-animation="slideUp" data-duration="1.5" data-delay="0" data-color="#caaf9c"
                                class="has-anim" alt="Single Image" src="../img/projects/warmly/chandelier.webp">

                        </div>
                        <!--/Single Image-->

                        <span class="a-empty-space" style="height: 25px"></span>

                        <!--Single Image-->
                        <div data-lightbox="img/projects/project-2/project_image_4.jpg" class="single-image">

                            <img data-animation="slideUp" data-duration="1.5" data-delay="0" data-color="#caaf9c"
                                class="has-anim" alt="Single Image" src="../img/projects/warmly/faucet.webp">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->

                    <!--Column-->
                    <div class="c-col-6 has-parallax">

                        <!--Single Image-->
                        <div data-lightbox="img/projects/project-2/project_image_3.jpg" class="single-image">

                            <img data-animation="slideUp" data-duration="1.5" data-delay=".1" data-color="#caaf9c"
                                class="has-anim" alt="Single Image" src="../img/projects/warmly/led.webp">

                        </div>
                        <!--/Single Image-->

                        <span class="a-empty-space" style="height: 25px"></span>

                        <!--Single Image-->
                        <div data-lightbox="img/projects/project-2/project_image_2.jpg" class="single-image">

                            <img data-animation="slideUp" data-duration="1.5" data-delay=".1" data-color="#caaf9c"
                                class="has-anim" alt="Single Image" src="../img/projects/warmly/lamp.webp">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->

                <!--Wrapper-->
                <div class="wrapper-small">

                    <!--Column-->
                    <div class="c-col-12">

                        <!--Text Wrapper-->
                        <div class="text-wrapper">

                            <h3 class="has-anim" data-stagger="0.1" data-duration="1.5" data-delay=".1"
                                data-animation="linesUp">
                                Co-founding Warmly Decor with my friend Matt was
                                an intense learning experience. While the journey was often grueling and at times
                                depressing, it proved to be invaluable. This venture equipped us with crucial skills in
                                management, digital marketing, business finance, and website development. Despite the
                                challenges, the knowledge gained from running this business has been immeasurable.
                            </h3>

                        </div>
                        <!--/Text Wrapper-->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->

                <!--Wrapper-->
                <div class="wrapper-small">

                    <!--Column-->
                    <div class="c-col-4">

                        <!--Text Wrapper-->
                        <div class="text-wrapper">

                            <h2 class="has-anim" data-stagger="0.02" data-duration="1" data-delay=".1"
                                data-animation="charsUp">
                                Third time's a charm.
                            </h2>

                        </div>
                        <!--/Text Wrapper-->

                    </div>
                    <!--/Column-->

                    <!--Column-->
                    <div class="c-col-8">

                        <!--Text Wrapper-->
                        <div class="text-wrapper">

                            <h5 style="color: rgba(25,27,29,.6)" class="has-anim" data-stagger="0.02" data-duration="1"
                                data-delay=".1" data-animation="wordsUp">
                                This venture marks my third attempt into the furniture and decoration sector, and I'm
                                pleased to say it has proven to be the most successful. The journey has reinforced the
                                value of persistence and staying true to one's vision. I'm truly grateful for two
                                things: the unwavering belief in my initial concept, and the support of an exceptional
                                business partner. Their presence has been instrumental in turning this endeavor into a
                                success story.
                            </h5>

                        </div>
                        <!--/Text Wrapper-->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->

            </div>
            <!--/Section -->

            <!--Section-->
            <div class="section">

                <!--Wrapper-->
                <div class="wrapper">

                    <!--Column-->
                    <div class="c-col-6">

                        <!--Single Image-->
                        <div class="single-image">

                            <img alt="Single Image" data-animation="slideLeft" data-duration="1.5" data-delay="0"
                                data-color="#caaf9c" class="has-anim" src="../img/projects/warmly/home.jpeg">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->

                    <!--Column-->
                    <div class="c-col-6">

                        <!--Single Image-->
                        <div class="single-image">

                            <img alt="Single Image" data-animation="slideLeft" data-duration="1.5" data-delay="0"
                                data-color="#caaf9c" class="has-anim" src="../img/projects/warmly/pinterest.png">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->


            </div>
            <!--/Section -->

        </div>
        <!-- /Page Content -->

        <!-- Next Project Section-->
        <div class="next-project-section section no-margin">

            <!--Next Project URL --><a href="stockAnalysis.html">

                <!-- Next Project Image-->
                <div class="next-project-image">

                    <img alt="Next Project Image" src="../img/projects/stock/stock.jpeg">

                </div>
                <!--/ Next Project Image-->

                <!-- Next Project Meta Wrapper-->
                <div class="wrapper-small no-nargin">

                    <div class="c-col-12">

                        <div class="next-project-wrap">

                            <!-- Next Project Text-->
                            <span>Next Project</span>
                            <!--/ Next Project Text-->

                            <!-- Next Project Title-->
                            <h1 class="next-project-title">Stock Analysis & Prediction Model</h1>
                            <!--/ Next Project Title-->

                        </div>

                    </div>

                </div>
                <!--/ Next Project Meta Wrapper-->

            </a>

        </div>
        <!--/ Next Project Section-->
    </div>
    <!-- /Page -->

{% include "footer-3.njk" %}

{% include "scripts-1.njk" %}
</body>

</html>