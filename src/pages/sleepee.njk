<!DOCTYPE html>
<html lang="en">

{% set title = "Sleepee" %}{% include "head-3.njk" %}


<body data-barba="wrapper" data-cursor="true" data-header-sticky="true" data-menu-style="classic"
    data-page-layout="light" data-header-layout="dark" data-menu-layout="light" data-footer-layout="light"
    data-page-loader="false">

{% include "page-chrome-1.njk" %}

{% include "header-3.njk" %}

    <!-- Page -->
    <div id="page" class="project-page" data-barba="container" data-barba-namespace="pph-video">

        <!-- Project Page Header -->
        <div data-animate="true" class="project-page-header style_2">

            <!-- Project Header Image -->
            <div class="project-fetaured-image">

                <img alt="Project Header Image" src="../img/projects/sleepee/cover.jpg">

            </div>
            <!-- /Project Header Image -->

            <!-- Project Head -->
            <div class="project-head">

                <!-- Project Title -->
                <div class="project-title">
                    <h1 class="big-title" style="color: whitesmoke;">Sleepee</h1>
                </div>
                <!-- /Project Title -->

                <!-- Project Category -->
                <div class="project-cat" style="color: whitesmoke;">Brand</div>
                <!-- /Project Category -->

            </div>
            <!-- /Project Head -->

            <!-- Project Details -->
            <div class="project-details">

                <!-- Project Metas -->
                <div class="project-metas">

                    <!-- Project Meta -->
                    <div class="project-meta project-other">

                        <h5>Jason</h5>

                    </div>
                    <!-- /Project Meta -->

                    <!-- Project Meta -->
                    <div class="project-meta meta-summary">

                        <!-- Meta Content-->
                        <h5>This project marked my entry into the world of e-commerce, focusing on selling decoration
                            and furniture online. Though eventually sold to another party, this venture proved to be an
                            invaluable learning experience in the realms of digital entrepreneurship.</h5>
                        <!-- /Meta Content-->

                    </div>
                    <!-- /Project Meta -->

                </div>
                <!-- /Project Metas -->

            </div>
            <!-- /Project Details -->

        </div>
        <!-- /Project Page Header -->


        <!-- Page Content -->
        <div id="content" class="page-content">

            <!--Section-->
            <div class="section">

                <!--Wrapper-->
                <div class="wrapper">

                    <!--Column-->
                    <div class="c-col-6">

                        <!--Single Image-->
                        <div data-lightbox="img/projects/project-7/image_1.jpg" class="single-image">

                            <img alt="Single Image" src="../img/projects/sleepee/pillow.jpg">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->

                    <!--Column-->
                    <div class="c-col-6">

                        <!--Single Image-->
                        <div data-lightbox="img/projects/project-7/image_2.jpg" class="single-image">

                            <img alt="Single Image" src="../img/projects/sleepee/pillow2.jpg">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->





                <!--Wrapper-->
                <div class="wrapper-small">

                    <!--Column-->
                    <div class="c-col-2"></div>
                    <!--/Column-->

                    <!--Column-->
                    <div class="c-col-10">

                        <!--Text Wrapper-->
                        <div class="text-wrapper">

                            <h3 class="has-anim" data-stagger="0.1" data-duration="1.5" data-delay=".1"
                                data-animation="linesUp">
                                The project provided hands-on experience in creating an functional e-commerce platform,
                                managing online inventory, and implementing basic marketing tactics to reach potential
                                customers. While the business ultimately changed hands, the skills and insights gained
                                laid a solid foundation for my future endeavors in the digital space.
                            </h3>

                        </div>
                        <!--/Text Wrapper-->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->

            </div>
            <!--/Section -->

            <!--Section-->
            <div class="section">

                <!--Wrapper-->
                <div class="wrapper">

                    <!--Column-->
                    <div class="c-col-6">

                        <!--Single Image-->
                        <div class="single-image">

                            <img alt="Single Image" data-animation="slideUp" data-duration="1.5" data-delay="0"
                                data-color="#caaf9c" class="has-anim" src="../img/projects/sleepee/sleepee.png">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->

                    <!--Column-->
                    <div class="c-col-6">

                        <!--Single Image-->
                        <div class="single-image">

                            <img alt="Single Image" data-animation="slideUp" data-duration="1.5" data-delay="0"
                                data-color="#caaf9c" class="has-anim" src="../img/projects/sleepee/website.jpg">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->



            </div>
            <!--/Section -->



        </div>
        <!-- /Page Content -->

        <!-- Next Project Section-->
        <div class="next-project-section section no-margin">

            <!--Next Project URL --><a href="videco.html">

                <!-- Next Project Image-->
                <div class="next-project-image">

                    <img alt="Next Project Image" src="../img/projects/videco/videco.png">

                </div>
                <!--/ Next Project Image-->

                <!-- Next Project Meta Wrapper-->
                <div class="wrapper-small no-nargin">

                    <div class="c-col-12">

                        <div class="next-project-wrap">

                            <!-- Next Project Text-->
                            <span>Next Project</span>
                            <!--/ Next Project Text-->

                            <!-- Next Project Title-->
                            <h1 class="next-project-title">Videco</h1>
                            <!--/ Next Project Title-->

                        </div>

                    </div>

                </div>
                <!--/ Next Project Meta Wrapper-->

            </a>

        </div>
        <!--/ Next Project Section-->

    </div>
    <!-- /Page -->

{% include "footer-3.njk" %}

{% include "scripts-1.njk" %}
</body>

</html>