                            <img alt="Single Image" src="../img/projects/videco/maxi.jpg">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->

                    <!--Column-->
                    <div class="c-col-6">


                        <!--Single Image-->
                        <div data-parallax-type="" data-parallax="true" class="single-image">

                            <img alt="Single Image" src="../img/projects/videco/mini.jpg">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->

            </div>
            <!--/Section -->


            <!--Section-->
