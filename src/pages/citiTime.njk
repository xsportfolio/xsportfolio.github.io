<!DOCTYPE html>
<html lang="en">

{% set title = "Citi Time" %}{% include "head-3.njk" %}


<body data-barba="wrapper" data-cursor="true" data-header-sticky="true" data-menu-style="classic"
    data-page-layout="light" data-header-layout="dark" data-menu-layout="light" data-footer-layout="light"
    data-page-loader="false">

{% include "page-chrome-1.njk" %}

{% include "header-3.njk" %}

    <!-- Page -->
    <div id="page" class="project-page" data-barba="container" data-barba-namespace="pph2">

        <!-- Project Page Header -->
        <div data-animate="true" class="project-page-header style_2">

            <!-- Project Header Image -->
            <div class="project-featured-image">
                <img alt="Project Featured Image" src="../img/projects/citiTime/building.jpeg">
            </div>
            <!-- /Project Header Image -->

            <!-- Project Head -->
            <div class="project-head">

                <!-- Project Title -->
                <div class="project-title">
                    <h1 class="big-title" style="color: white;">Citi Time</h1>
                </div>
                <!-- /Project Title -->

                <!-- Project Category -->
                <div class="project-cat" style="color: whitesmoke;">Brand</div>
                <!-- /Project Category -->

            </div>
            <!-- /Project Head -->

            <!-- Project Details -->
            <div class="project-details">

                <!-- Project Metas -->
                <div class="project-metas">

                    <!-- Project Meta -->
                    <div class="project-meta project-other">

                        <h5>Sunny</h5>

                    </div>
                    <!-- /Project Meta -->

                    <!-- Project Meta -->
                    <div class="project-meta meta-summary">

                        <!-- Meta Content-->
                        <h5>Citi Time is a leading project management firm specializing in large-scale infrastructure
                            and expanding into residential and eco-tourism development. Our branding strategy aimed to
                            reflect their core values of reliability, trust, and teamwork while highlighting their
                            expertise in stakeholder engagement and construction management. The challenge was to create
                            a cohesive identity that resonated across their diverse project portfolio, from urban
                            infrastructure to community facilities, emphasizing their commitment to successful planning
                            and execution.</h5>
                        <!-- /Meta Content-->

                    </div>
                    <!-- /Project Meta -->

                </div>
                <!-- /Project Metas -->

            </div>
            <!-- /Project Details -->

        </div>
        <!-- /Project Page Header -->

        <!-- Page Content -->
        <div id="content" class="page-content">

            <!--Section-->
            <div class="section">

                <!--Wrapper-->
                <div class="wrapper">

                    <!--Column-->
                    <div class="c-col-6">

                        <!--Single Image-->
                        <div class="single-image">

                            <img data-animation="blockUp" data-duration="1" data-color="#e3cdb6" class="has-anim"
                                alt="Single Image" src="../img/projects/citiTime/1.png">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->

                    <!--Column-->
                    <div class="c-col-6">

                        <!--Single Image-->
                        <div class="single-image">

                            <img data-animation="blockUp" data-duration="1" data-delay=".4" data-color="#caaf9c"
                                class="has-anim" alt="Single Image" src="../img/projects/citiTime/2.png">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->

                <!--Wrapper-->
                <div class="wrapper">

                    <!--Column-->
                    <div class="c-col-4"></div>
                    <!--/Column-->

                    <!--Column-->
                    <div class="c-col-8">

                        <!--Text Wrapper-->
                        <div class="text-wrapper">

                            <h3 class="has-anim" data-stagger="0.1" data-duration="1.5" data-delay=".1"
                                data-animation="linesUp">
                                Recognizing Citi Time's position in the serious and traditional sectors of
                                infrastructure and urban planning, I engaged in multiple consultations with the founder,
                                Sunny. These meetings were crucial for gaining deeper insights into the brand,
                                understanding its target audience, and aligning our approach with Sunny's vision. This
                                collaborative process ensured that our branding strategy would effectively represent
                                Citi Time's expertise and values in these established industries.
                            </h3>

                        </div>
                        <!--/Text Wrapper-->

                    </div>
                    <!--/Column-->

                </div>
                <!--/Wrapper-->

                <!--Wrapper-->
                <div class="wrapper">

                    <!--Column-->
                    <div class="c-col-12">

                        <!--Single Image-->
                        <div data-lightbox="img/projects/light/project-1/image_3.jpg" class="single-image">

                            <img data-animation="blockUp" data-duration=".6" data-delay="0" data-color="#caaf9c"
                                class="has-anim" alt="Single Image" src="../img/projects/citiTime/entrance.jpeg">

                        </div>
                        <!--/Single Image-->

                    </div>
                    <!--/Column-->



                </div>
                <!--/Wrapper-->



            </div>
            <!--/Section -->



        </div>
        <!-- /Page Content -->

